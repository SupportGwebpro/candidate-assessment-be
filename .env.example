# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for the React frontend, or * for any.
CORS_ORIGIN=http://localhost:3000

# --- Database (MySQL) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/assessment_db"

# --- Auth ---
# Use a long random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"
BCRYPT_ROUNDS=10

# --- Seed admin (created by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="HR Admin"

# --- DeepSeek AI (OpenAI-compatible) ---
# deepseek-chat / deepseek-reasoner were deprecated 2026-07-24;
# deepseek-v4-flash is the non-thinking successor (use deepseek-v4-pro for reasoning).
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_TIMEOUT_MS=60000
# Set AI_MOCK=true to return deterministic sample data without calling DeepSeek.
# (AI endpoints also auto-mock in non-production when DEEPSEEK_API_KEY is empty.)
AI_MOCK=false

# --- Uploads ---
UPLOAD_MAX_BYTES=10485760   # 10 MB max for job-description files
